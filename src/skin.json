{
  "name": "Lumina",
  "author": "Fina",
  "description": "Translucent glass over a living backdrop: aurora, pictures, videos, or Wallpaper Engine scenes and web wallpapers. 流光：玻璃界面与流动的壁纸。",
  "version": "1.1.1",
  "tags": ["Dark", "Transparent", "Blur", "Rounded"],
  "RootColors": "css/root-colors.css",
  "UseDefaultPatches": true,
  "Patches": [
    {
      "MatchRegexString": ".*",
      "TargetCss": "css/base.css"
    },
    {
      "MatchRegexString": ".*",
      "TargetJs": "js/aurora.js"
    },
    {
      "MatchRegexString": ".*",
      "TargetJs": "js/menu-anim.js"
    },
    {
      "MatchRegexString": ".*",
      "TargetJs": "js/wallpaper.js"
    },
    {
      "MatchRegexString": ".*",
      "TargetJs": "js/i18n.js"
    },
    {
      "MatchRegexString": "^Steam$",
      "TargetCss": "css/library.css"
    },
    {
      "MatchRegexString": "^Steam$",
      "TargetJs": "js/root-has.js"
    },
    {
      "MatchRegexString": "^Steam$",
      "TargetJs": "js/library-anim.js"
    },
    {
      "MatchRegexString": "^Steam$",
      "TargetJs": "js/smooth-scroll.js"
    },
    {
      "MatchRegexString": "^Steam$",
      "TargetJs": "js/morph-nav.js"
    },
    {
      "MatchRegexString": "^Steam$",
      "TargetJs": "js/url-bar.js"
    },
    {
      "MatchRegexString": "^Steam$",
      "TargetJs": "js/nav-fit.js"
    },
    {
      "MatchRegexString": "^Steam$",
      "TargetJs": "js/bottom-bar.js"
    },
    {
      "MatchRegexString": "^Steam$",
      "TargetJs": "js/liquid-glass.js"
    },
    {
      "MatchRegexString": ".friendsui-container",
      "TargetCss": "css/friends.css"
    }
  ],
  "Conditions": {
    "Backdrop": {
      "tab": "Backdrop",
      "description": "What shows behind the glass. Acrylic needs the Lumina Extended plugin.",
      "default": "Aurora",
      "values": {
        "Wallpaper": { "TargetCss": { "affects": [".*"], "src": "css/conditions/backdrop-wallpaper.css" } },
        "Aurora": { "TargetCss": { "affects": [".*"], "src": "css/conditions/backdrop-aurora.css" } },
        "Acrylic": { "TargetCss": { "affects": [".*"], "src": "css/conditions/backdrop-acrylic.css" } }
      }
    },
    "Blur": {
      "tab": "Backdrop",
      "description": "How much the backdrop is blurred.",
      "default": 0,
      "slider": { "cssVariable": "--lm-wall-blur", "min": 0, "max": 64, "step": 1, "unit": "px" }
    },
    "Wallpaper mouse": {
      "tab": "Backdrop",
      "description": "Scene wallpapers follow the mouse.",
      "default": "On",
      "values": {
        "On": { "TargetCss": { "affects": [".*"], "src": "css/conditions/wall-mouse-on.css" } },
        "Off": { "TargetCss": { "affects": [".*"], "src": "css/conditions/wall-mouse-off.css" } }
      }
    },
    "Desktop blur": {
      "tab": "Backdrop",
      "description": "Blur strength when the desktop shows through.",
      "default": "Soft",
      "values": {
        "Soft": { "TargetCss": { "affects": [".*"], "src": "css/conditions/acrylic-soft.css" } },
        "Strong": { "TargetCss": { "affects": [".*"], "src": "css/conditions/acrylic-strong.css" } }
      }
    },
    "Game list": {
      "tab": "Interface",
      "description": "Liquid glass refracts at the edges; Acrylic is frosted blur.",
      "default": "Liquid glass",
      "values": {
        "Liquid glass": { "TargetCss": { "affects": [".*"], "src": "css/conditions/list-liquid.css" } },
        "Acrylic": { "TargetCss": { "affects": [".*"], "src": "css/conditions/list-acrylic.css" } }
      }
    },
    "Liquid opacity": {
      "tab": "Interface",
      "description": "Tint of the liquid glass.",
      "default": 30,
      "slider": { "cssVariable": "--lm-liquid-alpha", "min": 0, "max": 60, "step": 2, "unit": "%" }
    },
    "Refraction": {
      "tab": "Interface",
      "description": "How far in the edges refract.",
      "default": 55,
      "slider": { "cssVariable": "--lm-refraction", "min": 0, "max": 100, "step": 5, "unit": "%" }
    },
    "Acrylic blur": {
      "tab": "Interface",
      "description": "Blur of the acrylic.",
      "default": 2,
      "slider": { "cssVariable": "--lm-acrylic-blur", "min": 0, "max": 48, "step": 1, "unit": "px" }
    },
    "Opacity": {
      "tab": "Interface",
      "description": "Panel tint: lower is clearer.",
      "default": 20,
      "slider": { "cssVariable": "--lm-alpha", "min": 10, "max": 80, "step": 2, "unit": "%" }
    },
    "Corner radius": {
      "tab": "Interface",
      "description": "Rounding of panels, buttons and menus.",
      "default": 15,
      "slider": { "cssVariable": "--lm-radius", "min": 0, "max": 20, "step": 1, "unit": "px" }
    },
    "Nav position": {
      "tab": "Interface",
      "description": "Where the Store / Library / Community capsule sits; Left and Right use a second row.",
      "default": "Center",
      "values": {
        "Center": { "TargetCss": { "affects": [".*"], "src": "css/conditions/navpos-center.css" } },
        "Left": { "TargetCss": { "affects": [".*"], "src": "css/conditions/navpos-left.css" } },
        "Right": { "TargetCss": { "affects": [".*"], "src": "css/conditions/navpos-right.css" } }
      }
    },
    "URL bar": {
      "tab": "Interface",
      "description": "Always: library pages show it too, with the page path.",
      "default": "Always",
      "values": {
        "Always": { "TargetCss": { "affects": [".*"], "src": "css/conditions/url-always.css" } },
        "Web pages": { "TargetCss": { "affects": [".*"], "src": "css/conditions/url-web.css" } }
      }
    },
    "Menu animation": {
      "tab": "Motion",
      "description": "How menus, collections and game pages animate.",
      "default": "Cascade",
      "values": {
        "Cascade": { "TargetCss": { "affects": [".*"], "src": "css/conditions/menu-cascade.css" } },
        "Fade": { "TargetCss": { "affects": [".*"], "src": "css/conditions/menu-fade.css" } },
        "Off": { "TargetCss": { "affects": [".*"], "src": "css/conditions/menu-off.css" } }
      }
    },
    "Nav menu": {
      "tab": "Motion",
      "description": "Morph: nav menus share one panel that morphs between them.",
      "default": "Morph",
      "values": {
        "Morph": { "TargetCss": { "affects": [".*"], "src": "css/conditions/nav-morph.css" } },
        "Native": { "TargetCss": { "affects": [".*"], "src": "css/conditions/nav-native.css" } }
      }
    },
    "Smooth scrolling": {
      "tab": "Motion",
      "description": "Mouse-wheel smoothing in the library.",
      "default": "Soft",
      "values": {
        "Soft": { "TargetCss": { "affects": [".*"], "src": "css/conditions/scroll-soft.css" } },
        "Standard": { "TargetCss": { "affects": [".*"], "src": "css/conditions/scroll-standard.css" } },
        "Off": { "TargetCss": { "affects": [".*"], "src": "css/conditions/scroll-off.css" } }
      }
    }
  }
}
